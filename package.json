{
  "name": "obrs",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration sit",
    "start:local": "ng serve",
    "start:https": "ng serve --ssl --configuration sit",
    "start:sit": "ng serve --configuration sit",
    "build": "ng build",
    "build:sit": "ng build --configuration sit",
    "build:prod": "node scripts/inject-prod-env.js && ng build --configuration prod",
    "deploy:sit": "ng build --configuration sit",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:i18n": "node scripts/check-i18n-parity.mjs",
    "test:auth-layout": "node scripts/check-auth-layout-styles.mjs",
    "test:alert-i18n": "node scripts/check-alert-i18n.mjs",
    "test:theme-tokens": "node scripts/check-admin-theme-tokens.mjs",
    "test:store-null": "node scripts/check-store-null-handling.mjs",
    "test:proto-key": "node scripts/check-prototype-key-lookup.mjs",
    "test:no-card-inputs": "node scripts/check-no-card-data-inputs.mjs",
    "test:e2e-lanes": "node scripts/check-e2e-lanes.mjs",
    "e2e": "playwright test",
    "e2e:gate": "playwright test --config=playwright.gate.config.ts",
    "e2e:local": "playwright test --config=playwright.local.config.ts",
    "e2e:ui": "playwright test --ui",
    "e2e:route-coverage": "node e2e/route-coverage.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~18.1.0",
    "@angular/cdk": "~18.2.14",
    "@angular/common": "~18.1.0",
    "@angular/compiler": "~18.1.0",
    "@angular/core": "~18.1.0",
    "@angular/forms": "~18.1.0",
    "@angular/google-maps": "^18.2.14",
    "@angular/platform-browser": "~18.1.0",
    "@angular/platform-browser-dynamic": "~18.1.0",
    "@angular/router": "~18.1.0",
    "@ngrx/effects": "~18.1.1",
    "@ngrx/store": "~18.1.1",
    "@ngrx/store-devtools": "~18.1.1",
    "@ngx-translate/core": "~15.0.0",
    "@ngx-translate/http-loader": "~8.0.0",
    "@popperjs/core": "~2.11.8",
    "@stomp/stompjs": "^7.3.0",
    "@zxing/browser": "^0.2.1",
    "bootstrap": "~5.3.3",
    "bootstrap-icons": "~1.11.3",
    "dayjs": "~1.11.13",
    "html2canvas": "^1.4.1",
    "jquery": "~3.7.1",
    "leaflet": "^1.9.4",
    "ngx-otp-input": "~1.1.2",
    "primeicons": "~7.0.0",
    "primeng": "~17.18.15",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "sweetalert2": "^11.26.18",
    "tslib": "~2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.1.2",
    "@angular/cli": "~18.1.2",
    "@angular/compiler-cli": "~18.1.0",
    "@playwright/test": "^1.61.0",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.5",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2"
  }
}
